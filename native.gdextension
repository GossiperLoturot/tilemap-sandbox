[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 = "res://target/debug/libnative_main.so"
linux.release.x86_64 = "res://target/release/libnative_main.so"
windows.debug.x86_64 = "res://target/debug/native_main.dll"
windows.release.x86_64 = "res://target/release/native_main.dll"
